	)
	(text "DRV8873S (per axis)\nVM = +30 V (36 V max). PWM_A -> IN2 -> OUT2 = coil +, PWM_B -> IN1 -> OUT1 = coil -.\nPower-up default is PWM mode; write MODE = 10b over SPI for independent half bridges.\nSPI mode 1, 16-bit frames, one ~{SCS} per axis. Set ~{SLEEP} high, wait 1.5 ms, then configure.\n~{FAULT} is open drain (low = fault). Clear with CLR_FLT or a short low pulse on ~{SLEEP}.\nDISABLE is shared by all three drivers: see the Nucleo sheet."
		(exclude_from_sim no)
		(at 16.256 132.588 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ffd2da35-bbb3-4ff4-bbc8-06a71600c6f9")
	)
