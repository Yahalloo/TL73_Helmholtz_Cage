	(text "RM3100 SUPPLY SELECT (0R links)"
		(exclude_from_sim no)
		(at 143.51 34.29 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left)
		)
		(uuid "3aba7c2e-1180-41a4-b06a-84cbd7ea7a04")
	)
	(text "J1302 (SPI): 1 GND, 2 VCC, 3 CS, 4 MISO, 5 MOSI, 6 SCK\nShares SPI1 with the drivers (they use mode 1, the RM3100 mode 0 or 3). CS = PD2.\nUse J1301 or J1302, not both."
		(exclude_from_sim no)
		(at 19.05 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "64b6ddfa-96cc-4856-b4d8-42094a778a38")
	)
	(text "J1301 (I2C): 1 GND, 2 VCC, 3 SCL, 4 SDA, 5 DRDY, 6 NC\nSCL = PA15, SDA = PB7, DRDY = PC2. R1301, R1302: bus pull-ups."
		(exclude_from_sim no)
		(at 19.05 81.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "75ea49e3-957c-4d8a-b1af-942632c84fb1")
	)
	(text "One link per connector:\nR1303 / R1305 = 3.3 V (fitted), R1304 / R1306 = 5 V (not fitted).\nUse 5 V only with a breakout that has its own regulator."
		(exclude_from_sim no)
		(at 143.51 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9e90844b-6489-49c9-b268-70d966dcc76a")
	)
