TEXT -1024 -112 Left 2 ;34 V SUPPLY (as on the PCB)
TEXT -208 -112 Left 2 ;H-BRIDGE (DRV8873 output stage)   M1/M2 = OUT A leg,  M3/M4 = OUT B leg
TEXT 560 96 Left 2 ;COIL with its winding capacitance
TEXT -288 656 Left 2 ;RcmP/CcmP, RcmN/CcmN, RsD/CsD = PCB snubbers at the connector.   RsE/CsE = optional snubber at the coil.
TEXT -288 688 Left 2 ;Cw, Ccm1, Ccm2, Llead1, Llead2 = cable and winding parasitics (estimates).
TEXT -1024 768 Left 2 ;PWM CONTROL (what the STM32 and the DRV8873 logic do). hA, lA, hB, lB drive the four gates above.
TEXT 2000 -112 Left 2 ;---- DRV8873S, Y AXIS (Rev B, hot), NO OUTPUT FILTER: steady 3.12 A, driver loss and ripple for both schemes at 20 kHz and 100 kHz (coil snubbers not fitted) ----
TEXT 2000 -80 Left 2 ;mode = 0: ONE SIDE HELD, OTHER SWITCHING. Command = signed duty d (-1..+1). dir = 1: M4 held on, leg A switches at |d|. dir = 0: M2 held on, leg B switches.
TEXT 2000 -48 Left 2 ;mode = 1: UNIPOLAR. Command D (0.5 = 0 V). Leg A switches at D, leg B at 1-D.
TEXT 2000 -16 Left 2 ;sig1/sig2 = STM32 pins.  mode 0: EN (PWM) and PH (direction).  mode 1: PWM_A and PWM_B.
TEXT 2000 32 Left 2 ;---- ADJUST THESE ----
TEXT 2000 64 Left 2 !.param Vbus=34
TEXT 2000 96 Left 2 !.step param mode list 0 1
TEXT 2000 128 Left 2 !.param fsw=20k
TEXT 2000 160 Left 2 !.param Lc=18.8m Rc=10.53 Rsh=10m
TEXT 2000 192 Left 2 !.param I0=2.46 I1=2.46 Islew=200 t1=0.3m
TEXT 2000 224 Left 2 !.param tsave=14m tstop=15m dtmax={T/200}
TEXT 2000 256 Left 2 !.param kT=1.5 Tamb=30 SR=53.2e6
TEXT 2000 288 Left 2 ;Parasitics (estimates): inductance and resistance per coil lead, winding capacitance, each coil terminal to GND, supply lead
TEXT 2000 320 Left 2 !.param Llead=1u Rlead=1m Cw=400p Ccm=200p Lsup=0.5u Rsup=20m
TEXT 2000 352 Left 2 !.param RsD=33 CsD=1f RsCM=33 CsCM=1f RsE=68 CsE=1f
TEXT 2000 384 Left 2 !.param Cbulk=330u ESRb=50m RsV=3.3 CsV=10n
TEXT 2000 432 Left 2 ;---- DRV8873 values (150 mOhm HS+LS at 25 C, 250 mOhm at 150 C, RthJA 27.8 C/W, 53.2 V/us fastest slew, tPD ~1.5 us) ----
TEXT 2000 464 Left 2 !.param Rds=75m td=300n Vg=5 Cgdx=0.1n RthJA=27.8 Pq=0.12 tmin=2u
TEXT 2000 496 Left 2 !.param Ron={Rds*kT} Rtot={Rc+2*Ron+Rsh+2*Rlead}
TEXT 2000 528 Left 2 !.param T={1/fsw} dd={td/T} Dmin={tmin*fsw} Dmax={1-tmin*fsw}
TEXT 2000 560 Left 2 ;tc = duty lost to the driver's switching delay and dead time (found from a first run). The command is raised by tc*fsw to make up for it; a closed current loop does this by itself.
TEXT 2000 592 Left 2 !.param tc={if(fsw>50k,1.1u,1.5u)} u0={I0*Rtot/Vbus} u1={I1*Rtot/Vbus} tramp={abs(I1-I0)/Islew+1n}
TEXT 2000 624 Left 2 !.param D0={mode*(0.5*(1+u0)+sgn(u0)*tc*fsw)+(1-mode)*(u0+sgn(u0)*tc*fsw)} D1={mode*(0.5*(1+u1)+sgn(u1)*tc*fsw)+(1-mode)*(u1+sgn(u1)*tc*fsw)}
TEXT 2000 656 Left 2 !.param Rgs={(Vg-3.3)/(Cgdx*SR)}
TEXT 2000 688 Left 2 !.model NFET VDMOS(Vto=3 Kp=40 Rd={Ron-2m-1/(40*(Vg-3))} Rs=2m Rg={Rgs} Cgdmax={Cgdx} Cgdmin={0.9*Cgdx} Cgs=2.5n Cjo=0.6n Is=1e-11 Rb=20m)
TEXT 2000 720 Left 2 !.ic I(Lcoil)={I0}
TEXT 2000 752 Left 2 !.tran 0 {tstop} {tsave} {dtmax}
TEXT 2000 800 Left 2 !.meas TRAN Iavg AVG I(Lcoil) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 832 Left 2 !.meas TRAN Iripple PP I(Lcoil) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 864 Left 2 !.meas TRAN Vcoil_max MAX V(X,Z) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 896 Left 2 !.meas TRAN Vcoil_min MIN V(X,Z) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 928 Left 2 !.meas TRAN Vbus_pp PP V(VBUS) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 960 Left 2 !.meas TRAN Pdrv AVG (V(VBUS)-V(A))*Id(M1)+V(A)*Id(M2)+(V(VBUS)-V(B))*Id(M3)+V(B)*Id(M4) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 992 Left 2 !.meas TRAN Psnub_diff AVG I(RsD)*I(RsD)*{RsD} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 1024 Left 2 !.meas TRAN Psnub_cm AVG (I(RcmP)*I(RcmP)+I(RcmN)*I(RcmN))*{RsCM} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 1056 Left 2 !.meas TRAN Psnub_vm AVG I(R304)*I(R304)*{RsV} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 1088 Left 2 !.meas TRAN Psnub_coil AVG I(RsE)*I(RsE)*{RsE} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
TEXT 2000 1120 Left 2 !.meas Tj PARAM {Tamb+RthJA*(Pdrv+Pq)}
TEXT 2000 1152 Left 2 !.save I(Lcoil) V(A) V(B) V(CP) V(X) V(Z) V(VBUS) V(sig1) V(sig2) V(duty) V(dir) V(dcl) V(tri) Id(M1) Id(M2) Id(M3) Id(M4) I(RsD) I(RcmP) I(RcmN) I(R304) I(RsE) I(Lsup) I(V1)
