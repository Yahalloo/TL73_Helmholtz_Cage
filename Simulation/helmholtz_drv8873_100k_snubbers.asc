TEXT 1184 -96 Left 2 ;---- DRV8873S (DRV8873SPWPR), NO OUTPUT FILTER, PCB SNUBBERS, Z AXIS ----
TEXT 1184 -64 Left 2 ;mode = 1: UNIPOLAR (both legs switch: leg A at duty D, leg B at 1-D; IN1/IN2 in independent half-bridge mode, MODE = 10b).
TEXT 1184 -32 Left 2 ;mode = 0: SIGN-MAGNITUDE. Command = signed duty d (-1 to +1): duty = |d| on the switching leg, dir = sign. dir = 1: M4 held, leg A switches. dir = 0: M2 held, leg B switches.
TEXT 1184 0 Left 2 ;mode 1 command: D (0.5 = 0 V). mode 0 command: d (0 = 0 V). Both are computed from I0/I1 below.  sig1/sig2 = STM32 pins: mode 1 -> PWM_A, PWM_B; mode 0 -> EN (PWM), PH (direction).
TEXT 1184 48 Left 2 ;---- ADJUST THESE ----
TEXT 1184 80 Left 2 !.param mode=0 Vbus=24 fsw=100k
TEXT 1184 112 Left 2 !.param Lc=21.0m Rc=4.42 Rsh=10m
TEXT 1184 144 Left 2 !.param I0=3.12 I1=3.12 Islew=200 t1=0.3m
TEXT 1184 176 Left 2 !.param tsave=0.5m tstop=1.5m dtmax=5n
TEXT 1184 208 Left 2 !.param kT=1.5 Tamb=30 SR=53.2e6
TEXT 1184 240 Left 2 ;Parasitics (estimates; measure the real coil): lead L and R per lead, winding C across the coil, each terminal to GND
TEXT 1184 272 Left 2 !.param Llead=1u Rlead=1m Cw=400p Ccm=200p
TEXT 1184 304 Left 2 ;PCB snubbers (R1201-R1209, C1203-C1211; DNP on the board). Set a C to 1f to leave that snubber out.
TEXT 1184 336 Left 2 !.param RsD=33 CsD=470p RsCM=33 CsCM=470p
TEXT 1184 368 Left 2 ;Supply: lead from the bench supply, bulk C307 330 uF, VM snubber R304 3.3 Ohm + C306 10 nF
TEXT 1184 400 Left 2 !.param Lsup=0.5u Rsup=20m Cbulk=330u ESRb=50m RsV=3.3 CsV=10n
TEXT 1184 448 Left 2 ;---- DRV8873 values (150 mOhm HS+LS at 25 C, 250 mOhm at 150 C, RthJA 27.8 C/W, 53.2 V/us fastest slew, tPD ~1.5 us) ----
TEXT 1184 480 Left 2 !.param Rds=75m td=200n Vg=10 RthJA=27.8 Pq=0.12 tmin=2u
TEXT 1184 512 Left 2 !.param Ron={Rds*kT} Rtot={Rc+2*Ron+Rsh+2*Rlead}
TEXT 1184 544 Left 2 !.param T={1/fsw} dd={td/T} Dmin={tmin*fsw} Dmax={1-tmin*fsw}
TEXT 1184 576 Left 2 !.param u0={I0*Rtot/Vbus} u1={I1*Rtot/Vbus} D0={mode*0.5*(1+u0)+(1-mode)*u0} D1={mode*0.5*(1+u1)+(1-mode)*u1} tramp={abs(I1-I0)/Islew+1n}
TEXT 1184 608 Left 2 !.param Rgs={(Vg-4)/(0.8n*SR)}
TEXT 1184 640 Left 2 !.model NFET VDMOS(Vto=3 Kp=40 Rd={Ron-2m-1/(40*(Vg-3))} Rs=2m Rg={Rgs} Cgdmax=0.8n Cgdmin=0.05n Cgs=1.5n Cjo=0.6n Is=1e-11 Rb=20m)
TEXT 1184 672 Left 2 !.ic I(Lcoil)=3.12
TEXT 1184 704 Left 2 !.tran 0 {tstop} {tsave} {dtmax}
TEXT 1184 752 Left 2 !.meas TRAN Iavg AVG I(Lcoil) FROM {tstop-0.5m} TO {tstop}
TEXT 1184 784 Left 2 !.meas TRAN Iripple PP I(Lcoil) FROM {tstop-0.5m} TO {tstop}
TEXT 1184 816 Left 2 !.meas TRAN Vcoil_max MAX V(X,Z) FROM {tstop-0.5m} TO {tstop}
TEXT 1184 848 Left 2 !.meas TRAN Vcoil_min MIN V(X,Z) FROM {tstop-0.5m} TO {tstop}
TEXT 1184 880 Left 2 !.meas TRAN Vbus_pp PP V(VBUS) FROM {tstop-0.5m} TO {tstop}
TEXT 1184 912 Left 2 !.meas TRAN Pdrv AVG (V(VBUS)-V(A))*Id(M1)+V(A)*Id(M2)+(V(VBUS)-V(B))*Id(M3)+V(B)*Id(M4) FROM {tstop-0.5m} TO {tstop}
TEXT 1184 944 Left 2 !.meas TRAN Psnub_diff AVG I(RsD)*I(RsD)*{RsD} FROM {tstop-0.5m} TO {tstop}
TEXT 1184 976 Left 2 !.meas TRAN Psnub_cm AVG (I(RcmP)*I(RcmP)+I(RcmN)*I(RcmN))*{RsCM} FROM {tstop-0.5m} TO {tstop}
TEXT 1184 1008 Left 2 !.meas TRAN Psnub_vm AVG I(R304)*I(R304)*{RsV} FROM {tstop-0.5m} TO {tstop}
TEXT 1184 1040 Left 2 !.meas Tj PARAM {Tamb+RthJA*(Pdrv+Pq)}
TEXT 1184 1088 Left 2 ;Nodes: A, B = DRV8873 outputs (B is also Coil- at the connector). CP = Coil+ at the connector (after the shunt). X, Z = coil terminals at the far end of the leads.
TEXT 1184 1120 Left 2 ;Plot I(Lcoil), V(X,Z) (coil voltage), V(CP,B) (connector voltage), V(sig1), V(sig2). Zoom on one edge to see lead ringing.
TEXT 1184 1152 Left 2 ;Compare: .step param CsD list 1f 470p 1.5n   (no snubber / PCB value / 3x Cpar).  Snubber at the coil end: change RsD's top flag to X and CsD's bottom flag to Z.
TEXT 1184 1184 Left 2 ;.ic starts the coil at 3.12 A: if you change I0, change the .ic values to match. For a current reversal set I0=-3.12, I1=3.12, Islew=200 and t1=1m tstop=40m (slow run).
