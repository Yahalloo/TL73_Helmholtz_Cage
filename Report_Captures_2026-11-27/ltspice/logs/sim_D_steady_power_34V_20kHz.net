* Generated by LTspice 24.1.4 for Windows.
V1 VIN 0 {Vbus}
Lsup VIN VBUS {Lsup} Rser={Rsup}
C307 VBUS 0 {Cbulk} Rser={ESRb}
C305 VBUS 0 100n Rser=5m
R304 VBUS N003 {RsV}
C306 N003 0 {CsV}
M1 VBUS N001 A A NFET
M2 A N004 0 0 NFET
BgA1 N001 A V={Vg}*V(hA)
BgA2 N004 0 V={Vg}*V(lA)
M3 VBUS N002 B B NFET
M4 B N005 0 0 NFET
BgB1 N002 B V={Vg}*V(hB)
BgB2 N005 0 V={Vg}*V(lB)
Rsh A CP {Rsh}
Llead1 CP X {Llead} Rser={Rlead}
Lcoil X M {Lc}
Rcoil M Z {Rc}
Llead2 Z B {Llead} Rser={Rlead}
Cw X Z {Cw}
RsE X N006 {RsE}
CsE N006 Z {CsE}
Ccm1 X 0 {Ccm}
Ccm2 Z 0 {Ccm}
RcmP CP N007 {RsCM}
CcmP N007 0 {CsCM}
RcmN B N008 {RsCM}
CcmN N008 0 {CsCM}
RsD CP N009 {RsD}
CsD N009 B {CsD}
Vtri tri 0 PULSE(0 1 0 {T/2-1n} {T/2-1n} 1n {T})
Vd dcmd 0 PWL(0 {D0} {t1} {D0} {t1+tramp} {D1})
Bclamp dcl 0 V=if({mode}==1,limit(V(dcmd),{Dmin},{Dmax}),limit(V(dcmd),-{Dmax},{Dmax}))
Bduty duty 0 V=abs(V(dcl))
Bdir dir 0 V=if(V(dcl)>=0,1,0)
Bsig1 sig1 0 V=if({mode}==1,if(V(dcl)>V(tri),3.3,0),if(V(duty)>V(tri),3.3,0))
Bsig2 sig2 0 V=if({mode}==1,if(1-V(dcl)>V(tri),3.3,0),3.3*V(dir))
BhA hA 0 V=if({mode}==1,if(V(dcl)>V(tri)+{dd},1,0),if(V(dir)>0.5,if(V(duty)>V(tri)+{dd},1,0),0))
BlA lA 0 V=if({mode}==1,if(V(dcl)<V(tri)-{dd},1,0),if(V(dir)>0.5,if(V(duty)<V(tri)-{dd},1,0),1))
BhB hB 0 V=if({mode}==1,if(1-V(dcl)>V(tri)+{dd},1,0),if(V(dir)<0.5,if(V(duty)>V(tri)+{dd},1,0),0))
BlB lB 0 V=if({mode}==1,if(1-V(dcl)<V(tri)-{dd},1,0),if(V(dir)<0.5,if(V(duty)<V(tri)-{dd},1,0),1))
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\adars\AppData\Local\LTspice\lib\cmp\standard.mos
* 34 V SUPPLY (as on the PCB)
* H-BRIDGE (DRV8873 output stage)   M1/M2 = OUT A leg,  M3/M4 = OUT B leg
* COIL with its winding capacitance
* RcmP/CcmP, RcmN/CcmN, RsD/CsD = PCB snubbers at the connector.   RsE/CsE = optional snubber at the coil.
* Cw, Ccm1, Ccm2, Llead1, Llead2 = cable and winding parasitics (estimates).
* PWM CONTROL (what the STM32 and the DRV8873 logic do). hA, lA, hB, lB drive the four gates above.
* ---- DRV8873S, Z AXIS, NO OUTPUT FILTER: steady 3.12 A, driver loss and ripple for both schemes at 20 kHz and 100 kHz (coil snubbers not fitted) ----
* mode = 0: ONE SIDE HELD, OTHER SWITCHING. Command = signed duty d (-1..+1). dir = 1: M4 held on, leg A switches at |d|. dir = 0: M2 held on, leg B switches.
* mode = 1: UNIPOLAR. Command D (0.5 = 0 V). Leg A switches at D, leg B at 1-D.
* sig1/sig2 = STM32 pins.  mode 0: EN (PWM) and PH (direction).  mode 1: PWM_A and PWM_B.
* ---- ADJUST THESE ----
.param Vbus=34
.step param mode list 0 1
.param fsw=20k
.param Lc=21.0m Rc=8 Rsh=10m
.param I0=3.12 I1=3.12 Islew=200 t1=0.3m
.param tsave=1m tstop=2m dtmax={T/200}
.param kT=1.5 Tamb=30 SR=53.2e6
* Parasitics (estimates): inductance and resistance per coil lead, winding capacitance, each coil terminal to GND, supply lead
.param Llead=1u Rlead=1m Cw=400p Ccm=200p Lsup=0.5u Rsup=20m
.param RsD=33 CsD=1f RsCM=33 CsCM=1f RsE=68 CsE=1f
.param Cbulk=330u ESRb=50m RsV=3.3 CsV=10n
* ---- DRV8873 values (150 mOhm HS+LS at 25 C, 250 mOhm at 150 C, RthJA 27.8 C/W, 53.2 V/us fastest slew, tPD ~1.5 us) ----
.param Rds=75m td=300n Vg=5 Cgdx=0.1n RthJA=27.8 Pq=0.12 tmin=2u
.param Ron={Rds*kT} Rtot={Rc+2*Ron+Rsh+2*Rlead}
.param T={1/fsw} dd={td/T} Dmin={tmin*fsw} Dmax={1-tmin*fsw}
* tc = duty lost to the driver's switching delay and dead time (found from a first run). The command is raised by tc*fsw to make up for it; a closed current loop does this by itself.
.param tc={if(fsw>50k,1.1u,1.5u)} u0={I0*Rtot/Vbus} u1={I1*Rtot/Vbus} tramp={abs(I1-I0)/Islew+1n}
.param D0={mode*(0.5*(1+u0)+sgn(u0)*tc*fsw)+(1-mode)*(u0+sgn(u0)*tc*fsw)} D1={mode*(0.5*(1+u1)+sgn(u1)*tc*fsw)+(1-mode)*(u1+sgn(u1)*tc*fsw)}
.param Rgs={(Vg-3.3)/(Cgdx*SR)}
.model NFET VDMOS(Vto=3 Kp=40 Rd={Ron-2m-1/(40*(Vg-3))} Rs=2m Rg={Rgs} Cgdmax={Cgdx} Cgdmin={0.9*Cgdx} Cgs=2.5n Cjo=0.6n Is=1e-11 Rb=20m)
.ic I(Lcoil)={I0}
.tran 0 {tstop} {tsave} {dtmax}
.meas TRAN Iavg AVG I(Lcoil) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Iripple PP I(Lcoil) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Vcoil_max MAX V(X,Z) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Vcoil_min MIN V(X,Z) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Vbus_pp PP V(VBUS) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Pdrv AVG (V(VBUS)-V(A))*Id(M1)+V(A)*Id(M2)+(V(VBUS)-V(B))*Id(M3)+V(B)*Id(M4) FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Psnub_diff AVG I(RsD)*I(RsD)*{RsD} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Psnub_cm AVG (I(RcmP)*I(RcmP)+I(RcmN)*I(RcmN))*{RsCM} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Psnub_vm AVG I(R304)*I(R304)*{RsV} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas TRAN Psnub_coil AVG I(RsE)*I(RsE)*{RsE} FROM {tstop-tsave-0.5m} TO {tstop-tsave}
.meas Tj PARAM {Tamb+RthJA*(Pdrv+Pq)}
.save I(Lcoil) V(A) V(B) V(CP) V(X) V(Z) V(VBUS) V(sig1) V(sig2) V(duty) V(dir) V(dcl) V(tri) Id(M1) Id(M2) Id(M3) Id(M4) I(RsD) I(RcmP) I(RcmN) I(R304) I(RsE) I(Lsup) I(V1)
.backanno
.end
