M1 VBUS gA1 A A NFET
M2 A gA2 0 0 NFET
M3 VBUS gB1 B B NFET
M4 B gB2 0 0 NFET
BgA1 gA1 A V=if({mode}==1,if(V(dcl)>V(tri)+{dd},{Vg},0),if(V(dir)>0.5,if(V(duty)>V(tri)+{dd},{Vg},0),0))
BgA2 gA2 0 V=if({mode}==1,if(V(dcl)<V(tri)-{dd},{Vg},0),if(V(dir)>0.5,if(V(duty)<V(tri)-{dd},{Vg},0),{Vg}))
BgB1 gB1 B V=if({mode}==1,if(1-V(dcl)>V(tri)+{dd},{Vg},0),if(V(dir)<0.5,if(V(duty)>V(tri)+{dd},{Vg},0),0))
BgB2 gB2 0 V=if({mode}==1,if(1-V(dcl)<V(tri)-{dd},{Vg},0),if(V(dir)<0.5,if(V(duty)<V(tri)-{dd},{Vg},0),{Vg}))
V1 VIN 0 {Vbus}
Lsup VIN VBUS {Lsup} Rser={Rsup}
C307 VBUS 0 {Cbulk} Rser={ESRb}
C305 VBUS 0 100n Rser=5m
R304 VBUS SV {RsV}
C306 SV 0 {CsV}
Rsh A CP {Rsh}
Llead1 CP X {Llead} Rser={Rlead}
Lcoil X M {Lc}
Rcoil M Z {Rc}
Llead2 Z B {Llead} Rser={Rlead}
Cw X Z {Cw}
Ccm1 X 0 {Ccm}
Ccm2 Z 0 {Ccm}
RsD CP SD {RsD}
CsD SD B {CsD}
RcmP CP S1 {RsCM}
CcmP S1 0 {CsCM}
RcmN B S2 {RsCM}
CcmN S2 0 {CsCM}
Vtri tri 0 PULSE(0 1 0 {T/2-1n} {T/2-1n} 1n {T})
Vd dcmd 0 PWL(0 {D0} {t1} {D0} {t1+tramp+1n} {D1})
Bclamp dcl 0 V=if({mode}==1,limit(V(dcmd),{Dmin},{Dmax}),limit(V(dcmd),-{Dmax},{Dmax}))
Bduty duty 0 V=abs(V(dcl))
Bdir dir 0 V=if(V(dcl)>=0,1,0)
Bsig1 sig1 0 V=if({mode}==1,if(V(dcl)>V(tri),3.3,0),if(V(duty)>V(tri),3.3,0))
Bsig2 sig2 0 V=if({mode}==1,if(1-V(dcl)>V(tri),3.3,0),3.3*V(dir))
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\adars\AppData\Local\LTspice\lib\cmp\standard.mos
* ---- DRV8873S (DRV8873SPWPR), NO OUTPUT FILTER, PCB SNUBBERS, Z AXIS, 34 V, 20 kHz ----
* mode = 1: UNIPOLAR (both legs switch: leg A at duty D, leg B at 1-D; IN1/IN2 in independent half-bridge mode, MODE = 10b).
* mode = 0: SIGN-MAGNITUDE. Command = signed duty d (-1 to +1): duty = |d| on the switching leg, dir = sign. dir = 1: M4 held, leg A switches. dir = 0: M2 held, leg B switches.
* mode 1 command: D (0.5 = 0 V). mode 0 command: d (0 = 0 V). Both are computed from I0/I1 below.  sig1/sig2 = STM32 pins: mode 1 -> PWM_A, PWM_B; mode 0 -> EN (PWM), PH (direction).
* ---- ADJUST THESE ----
.param mode=0 Vbus=34 fsw=20k
.param Lc=21.0m Rc=4.42 Rsh=10m
.param I0=3.12 I1=3.12 Islew=200 t1=0.3m
.param tsave=0.5m tstop=1.5m dtmax=5n
.param kT=1.5 Tamb=30 SR=53.2e6
* Parasitics (estimates; measure the real coil): lead L and R per lead, winding C across the coil, each terminal to GND
.param Llead=1u Rlead=1m Cw=400p Ccm=200p
* PCB snubbers (R1201-R1209, C1203-C1211; DNP on the board). Set a C to 1f to leave that snubber out.
.param RsD=33 CsD=470p RsCM=33 CsCM=470p
* Supply: lead from the bench supply, bulk C307 330 uF, VM snubber R304 3.3 Ohm + C306 10 nF
.param Lsup=0.5u Rsup=20m Cbulk=330u ESRb=50m RsV=3.3 CsV=10n
* ---- DRV8873 values (150 mOhm HS+LS at 25 C, 250 mOhm at 150 C, RthJA 27.8 C/W, 53.2 V/us fastest slew, tPD ~1.5 us) ----
.param Rds=75m td=200n Vg=10 RthJA=27.8 Pq=0.12 tmin=2u
.param Ron={Rds*kT} Rtot={Rc+2*Ron+Rsh+2*Rlead}
.param T={1/fsw} dd={td/T} Dmin={tmin*fsw} Dmax={1-tmin*fsw}
.param u0={I0*Rtot/Vbus} u1={I1*Rtot/Vbus} D0={mode*0.5*(1+u0)+(1-mode)*u0} D1={mode*0.5*(1+u1)+(1-mode)*u1} tramp={abs(I1-I0)/Islew+1n}
.param Rgs={(Vg-4)/(0.8n*SR)}
.model NFET VDMOS(Vto=3 Kp=40 Rd={Ron-2m-1/(40*(Vg-3))} Rs=2m Rg={Rgs} Cgdmax=0.8n Cgdmin=0.05n Cgs=1.5n Cjo=0.6n Is=1e-11 Rb=20m)
.ic I(Lcoil)=3.12
.tran 0 {tstop} {tsave} {dtmax}
.meas TRAN Iavg AVG I(Lcoil) FROM {tstop-0.5m} TO {tstop}
.meas TRAN Iripple PP I(Lcoil) FROM {tstop-0.5m} TO {tstop}
.meas TRAN Vcoil_max MAX V(X,Z) FROM {tstop-0.5m} TO {tstop}
.meas TRAN Vcoil_min MIN V(X,Z) FROM {tstop-0.5m} TO {tstop}
.meas TRAN Vbus_pp PP V(VBUS) FROM {tstop-0.5m} TO {tstop}
.meas TRAN Pdrv AVG (V(VBUS)-V(A))*Id(M1)+V(A)*Id(M2)+(V(VBUS)-V(B))*Id(M3)+V(B)*Id(M4) FROM {tstop-0.5m} TO {tstop}
.meas TRAN Psnub_diff AVG I(RsD)*I(RsD)*{RsD} FROM {tstop-0.5m} TO {tstop}
.meas TRAN Psnub_cm AVG (I(RcmP)*I(RcmP)+I(RcmN)*I(RcmN))*{RsCM} FROM {tstop-0.5m} TO {tstop}
.meas TRAN Psnub_vm AVG I(R304)*I(R304)*{RsV} FROM {tstop-0.5m} TO {tstop}
.meas Tj PARAM {Tamb+RthJA*(Pdrv+Pq)}
* Nodes: A, B = DRV8873 outputs (B is also Coil- at the connector). CP = Coil+ at the connector (after the shunt). X, Z = coil terminals at the far end of the leads.
* Plot I(Lcoil), V(X,Z) (coil voltage), V(CP,B) (connector voltage), V(sig1), V(sig2). Zoom on one edge to see lead ringing.
* Compare: .step param CsD list 1f 470p 1.5n   (no snubber / PCB value / 3x Cpar).  Snubber at the coil end: change RsD's top flag to X and CsD's bottom flag to Z.
* .ic starts the coil at 3.12 A: if you change I0, change the .ic values to match. For a current reversal set I0=-3.12, I1=3.12, Islew=200 and t1=1m tstop=40m (slow run).
.backanno
.end
