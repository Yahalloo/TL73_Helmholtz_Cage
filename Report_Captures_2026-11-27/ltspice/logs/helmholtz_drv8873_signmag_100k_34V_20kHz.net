* C:\Users\adars\AppData\Local\Temp\claude\d195a441006425e2\2cd0b001-3510-43e3-a3c9-5e3aa1fc306e\scratchpad\ltrun\helmholtz_drv8873_signmag_100k_34V_20kHz.asc
* Generated by LTspice 24.1.4 for Windows.
V1 VBUS 0 {Vbus}
M1 VBUS N001 A A NFET
M2 A N003 0 0 NFET
BgA1 N001 A V=if(V(dcl)>=0.5,if(abs(2*V(dcl)-1)>V(tri)+{dd},{Vg},0),0)
BgA2 N003 0 V=if(V(dcl)>=0.5,if(abs(2*V(dcl)-1)<V(tri)-{dd},{Vg},0),{Vg})
M3 VBUS N002 B B NFET
M4 B N004 0 0 NFET
BgB1 N002 B V=if(V(dcl)<0.5,if(abs(2*V(dcl)-1)>V(tri)+{dd},{Vg},0),0)
BgB2 N004 0 V=if(V(dcl)<0.5,if(abs(2*V(dcl)-1)<V(tri)-{dd},{Vg},0),{Vg})
L1 A X {Lf} Rser={RLf}
Lcoil X N005 {Lc}
Rcoil N005 Z {Rc}
L2 Z B {Lf} Rser={RLf}
C1 X 0 {Cf} Rser={ESR}
C2 Z 0 {Cf} Rser={ESR}
Vtri tri 0 PULSE(0 1 0 {T/2-1n} {T/2-1n} 1n {T})
Vd dcmd 0 PWL(0 {D0} {t1} {D0} {t1+tramp+1n} {D1})
Bclamp dcl 0 V=limit(V(dcmd),{Dmin},{Dmax})
Ben EN 0 V=if(abs(2*V(dcl)-1)>V(tri),3.3,0)
Bph PH 0 V=if(V(dcl)>=0.5,3.3,0)
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\adars\AppData\Local\LTspice\lib\cmp\standard.mos
* ---- DRV8873S (DRV8873SPWPR), SIGN-MAGNITUDE PWM (one leg held, other leg switching), 20 kHz, 34 V, Z AXIS ----
* Current A->B (D >= 0.5): M4 held on, leg A switches at duty |2D-1|.  Current B->A (D < 0.5): M2 held on, leg B switches.  Off-time freewheels through both low sides.
* EN = PWM pin (duty |2D-1|), PH = direction pin: the two signals the STM32 sends in the DRV8873's PH/EN mode (EN = 0 drives both outputs low = brake).
* ---- ADJUST THESE ----
.param Vbus=34 fsw=20k
.param Lc=21.0m Rc=4.42
.param I0=-3.12 I1=3.12 Islew=1e6
.param t1=30m tstop=60m
.param Lf=1p RLf=0 Cf=1p ESR=0
.param kT=1.5 Tamb=30 SR=53.2e6
* ---- DRV8873 values (datasheet: 150 mOhm HS+LS at 25 C, 250 mOhm at 150 C, RthJA 27.8 C/W, fastest slew 53.2 V/us, tPD ~1.5 us) ----
.param Rds=75m Npar=1 td=200n Vg=10 RthJA=27.8 Pq=0.12 tmin=2u
.param Ron={Rds*kT/Npar} Rpath={2*Ron} Rtot={Rc+Rpath+2*RLf}
.param T={1/fsw} dd={td/T} Dmin={0.5-(1-tmin*fsw)/2} Dmax={0.5+(1-tmin*fsw)/2}
.param D0={0.5*(1+I0*Rtot/Vbus)} D1={0.5*(1+I1*Rtot/Vbus)} tramp={abs(I1-I0)/Islew}
.param Rgs={(Vg-4)/(0.8n*SR)}
.model NFET VDMOS(Vto=3 Kp=40 Rd={Ron-2m-1/(40*(Vg-3))} Rs=2m Rg={Rgs} Cgdmax=0.8n Cgdmin=0.05n Cgs=1.5n Cjo=0.6n Is=1e-11 Rb=20m)
.tran 0 {tstop} 0 {T/100}
.meas TRAN Iavg AVG I(Rcoil) FROM {tstop-2m} TO {tstop}
.meas TRAN Iripple PP I(Rcoil) FROM {tstop-2m} TO {tstop}
.meas TRAN Pdrv AVG (V(VBUS)-V(A))*Id(M1)+V(A)*Id(M2)+(V(VBUS)-V(B))*Id(M3)+V(B)*Id(M4) FROM {tstop-2m} TO {tstop}
.meas Tj PARAM {Tamb+RthJA*(Pdrv+Pq)}
* kT = FET resistance vs temperature (1 = 25 C, 1.5 = ~120 C, 1.67 = 150 C).  Rgs slows the gate so output edges approximate the slew rate SR; check V(A) or V(B) edges and adjust.
* tmin = shortest usable pulse (tPD + edges); Dmin/Dmax keep the duty below 80% of the period.  td = dead time assumed for the model (the chip sets its own).
* At 100 kHz this run is long (fine timestep): for a quick check use t1=20m tstop=40m.  Results: View > SPICE Error Log.
.backanno
.end
