	)
	(text "BZ201: TMB09A05, 5 V active buzzer, about 30 mA. Pin 1 = +.\nBUZZER = PB3 (TIM2_CH2, also SWO): high = sound.\nBeep patterns are timed in firmware. D204: flyback diode."
		(exclude_from_sim no)
		(at 173.99 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "33549573-e6e4-414f-8013-e056ff5f3418")
	)
	(text "FAN DRIVER"
		(exclude_from_sim no)
		(at 44.45 74.93 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left)
		)
		(uuid "cf62dd8c-4027-4406-a58f-544ba78f6aa1")
	)
	(text "J206: JST XH, 2 pin. 1 = E5V (fan red), 2 = switched return (fan black).\nFan: Sunon MF40100V1, 5 V, 136 mA. FAN_EN = PB6 (TIM4_CH1): high = fan on, PWM possible.\nD203 carries the motor current at switch-off, D201 clamps the 5 V rail."
		(exclude_from_sim no)
		(at 44.45 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "db6f9c9c-7bbc-46da-a381-10dcc331c8f5")
	)
